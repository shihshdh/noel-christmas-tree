{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noel",
  "mainBinaryName": "Noel",
  "version": "1.1.0",
  "identifier": "app.noel.tree",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Noel",
    "copyright": "© 2026 Noel",
    "shortDescription": "Noël · Grand Luxury Tree 圣诞树",
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
